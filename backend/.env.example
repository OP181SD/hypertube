# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://hypertube:hypertube_secret@localhost:5434/hypertube
DATABASE_URL_TEST=postgresql://hypertube_test:hypertube_test_secret@localhost:5433/hypertube_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# OAuth - 42
FT_CLIENT_ID=your-42-client-id
FT_CLIENT_SECRET=your-42-client-secret
FT_CALLBACK_URL=http://localhost:3000/auth/42/callback

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-pass
MAIL_FROM=HyperTube <noreply@hypertube.local>

# Uploads
UPLOAD_PATH=./data/uploads

# External APIs
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
YTS_BASE_URL=https://yts.torrentbay.st/api/v2
EZTV_BASE_URL=https://eztv.re/api

# Streaming
STORAGE_PATH=./data/videos
FFMPEG_PATH=
OPENSUBTITLES_API_KEY=