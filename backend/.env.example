# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://hypertube:hypertube_secret@localhost:5434/hypertube

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# RESTful API clients (POST /oauth/token) — applied to the DB by `npm run prisma:seed`
OAUTH_CLIENT_ID=hypertube-web
OAUTH_CLIENT_SECRET=change-me-api-client-secret-min-16-chars

# OAuth - 42
FT_CLIENT_ID=your-42-client-id
FT_CLIENT_SECRET=your-42-client-secret
FT_CALLBACK_URL=http://localhost:3000/auth/42/callback

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# OAuth - Discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Email (Mailpit via docker compose — UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HyperTube <noreply@hypertube.local>

# Uploads
UPLOAD_PATH=./data/uploads

# External APIs
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
YTS_BASE_URL=https://movies-api.accel.li/api/v2
EZTV_BASE_URL=https://eztv1.xyz/api
OPENSUBTITLES_BASE_URL=https://api.opensubtitles.com/api/v1

# Streaming
STORAGE_PATH=./data/videos
# Optional override. Empty = binaries from @ffmpeg-installer/ffmpeg + ffprobe-static.
FFMPEG_PATH=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=