    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "handlebars": "^4.7.9",
    "ioredis": "^5.11.1",
    "joi": "^18.2.5",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-42": "^1.2.6",
    "passport-discord": "^0.1.4",
    "passport-github2": "^0.1.12",
