    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
