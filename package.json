{
  "name": "hypertube",
  "version": "6.3.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "overrides": {
    "fastify": "5.8.5",
    "ws": "^8.18.0",
    "hono": "^4.12.5",
    "@hono/node-server": "^1.19.11",
    "@types/pg": "8.20.0"
  },
  "scripts": {
    "setup": "bash setup.sh",
    "dev:back": "npm run start:dev --workspace=backend",
    "dev:front": "npm run dev --workspace=frontend",
    "build:back": "npm run build --workspace=backend",
    "build:front": "npm run build --workspace=frontend",
    "lint:back": "npm run lint --workspace=backend",
    "lint:front": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=backend",
    "prisma:studio": "npm run prisma:studio --workspace=backend",
    "debug:browser": "chromium-browser --remote-debugging-port=9222 --user-data-dir=/tmp/chromium-debug"
  }
}
